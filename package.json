{
  "name": "flowtranslate",
  "private": true,
  "version": "0.1.0",
  "description": "AI translation and language-learning coach for flowtranslate.app",
  "author": "Juan O",
  "homepage": "https://flowtranslate.app",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanobrach/entity-builders.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major",
    "test": "vitest run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy:prod": "npm run build -- --mode production && npx wrangler deploy"
  },
  "dependencies": {
    "@eb-packages/analytics": "1.0.0",
    "@eb-packages/app-registry": "workspace:*",
    "@eb-packages/auth": "workspace:*",
    "@eb-packages/auth-ui-web": "workspace:*",
    "@eb-packages/billing-core": "workspace:*",
    "@eb-packages/flowtranslate-core": "workspace:*",
    "@eb-packages/ui-web": "workspace:*",
    "@supabase/supabase-js": "^2.97.0",
    "lucide-react": "^0.564.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.90.0"
  }
}
